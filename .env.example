# ORBIT configuration proposal only; no application reads these values yet.
# No real credentials. Copy to .env only when a configuration loader is implemented.
ORBIT_MODE=mock
ORBIT_MODEL_PROVIDER=mock
ORBIT_MODEL_ID=
# Server-only credential; leave empty for mock mode.
ORBIT_MODEL_API_KEY=
# Server-only: local PostgreSQL for development; Supabase PostgreSQL for the demo.
# Obtain the connection string during implementation. Never expose it to the browser.
# Validate connection mode and TLS settings for migrations, workers and checkpoints.
DATABASE_URL=
ORBIT_DATA_DIR=./data
ORBIT_MAX_TASKS=8
ORBIT_MAX_CONCURRENCY=2
ORBIT_MAX_QUALITY_RETRIES=2
ORBIT_MAX_NETWORK_RETRIES=2
ORBIT_TASK_TIMEOUT_SECONDS=120
# A live mission must supply its budget; no implicit paid execution.
ORBIT_ALLOW_EXTERNAL_WRITES=false
