# Server-only local configuration. Existing .env files must not be overwritten.
# Live execution stays disabled until the user explicitly authorizes live testing.
ORBIT_ENABLE_LIVE=false
OPENAI_API_KEY=
ORBIT_MODEL_ID=gpt-5.4-mini
# Optional: postgresql+psycopg://... ; blank uses local work/studio.db (SQLite).
DATABASE_URL=
# Only for the optional local Docker Compose PostgreSQL service.
ORBIT_DB_PASSWORD=
# Optional dated price snapshot. Blank means unknown, not zero.
ORBIT_INPUT_USD_PER_MILLION=
ORBIT_OUTPUT_USD_PER_MILLION=
ORBIT_PRICE_SNAPSHOT_DATE=
